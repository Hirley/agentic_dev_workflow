require_relative '../ports/<%= entity_name %>_repository'

module Adapters
  # Implementação em memória da porta <%= class_name %>Repository, útil
  # para testes e para servir de exemplo de como implementar um adapter real.
  class InMemory<%= class_name %>Repository < Ports::<%= class_name %>Repository
    def initialize
      super
      @items = {}
    end

    def find(id)
      @items[id]
    end

    def save(<%= entity_name %>)
      @items[<%= entity_name %>.id] = <%= entity_name %>
    end

    def all
      @items.values
    end
  end
end
